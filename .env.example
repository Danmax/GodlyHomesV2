NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=godly_homes
DB_USER=godly_homes
DB_PASSWORD=replace-with-a-local-password
# Remote database connections always use verified TLS. Optional trusted CA file:
DB_SSL_CA_FILE=
# Set required to also use TLS over a loopback TCP connection.
DB_TLS=auto
AUTHOR_STORAGE_MB=5120
MEDIA_DIR=./data/media
# For a local studio sharing the production database, copy audio here before publishing.
# Leave empty on the hosted application itself.
MEDIA_REMOTE_URL=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ADMIN_EMAIL=owner@godlyhomes.com
ADMIN_PASSWORD=
SHOW_TITLE=Godly Homes
SHOW_DESCRIPTION=Encouragement for the home you are building.
SHOW_EMAIL=hello@godlyhomes.com
# Optional HTTPS URL for a square podcast cover image (required before directory submission).
SHOW_IMAGE_URL=
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Server-only Stripe keys. Use sandbox keys first; never add a VITE_ prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only after configuring Stripe Tax for this account.
STRIPE_AUTOMATIC_TAX=false

# Account email: Resend API. Verify godlyhomes.com in Resend before sending.
MAIL_PROVIDER=resend
MAIL_FROM=hello@godlyhomes.com
RESEND_API_KEY=
# Optional test recipient; defaults to ADMIN_EMAIL.
MAIL_TEST_TO=
# Public registration creates member accounts, without publishing/admin privileges.
REGISTRATION_ENABLED=true
