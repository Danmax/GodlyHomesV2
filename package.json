{
  "name": "godly-homes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "concurrently -k --names api,web,worker \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env --watch server/worker.js\"",
    "build": "NODE_ENV=production vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "worker": "node --env-file-if-exists=.env server/worker.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration.js",
    "test:pages": "node test/public-pages.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.1.0",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.16",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.5",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.56.1",
    "supertest": "7.1.4",
    "tailwindcss": "4.1.16",
    "vite": "7.3.7"
  }
}
